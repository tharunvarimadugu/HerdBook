# Environment Variables Template
# Copy this file to .env and update with your settings

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development

# Secret Keys (Generate secure keys for production)
SECRET_KEY=dev-secret-key-change-in-production-12345
JWT_SECRET_KEY=jwt-secret-key-change-in-production-12345

# Database
# Development (SQLite)
DATABASE_URL=sqlite:///database/farm.db

# Production (PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/farm_db

# Server
PORT=5000
HOST=0.0.0.0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Email (for alerts, future)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# AWS S3 (for backups, future)
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_S3_BUCKET=farm-backups

# External Services
# WEATHER_API_KEY=your-api-key
# IOT_GATEWAY_URL=http://gateway.farm.local:8080

# Google Drive Backup
# Create OAuth credentials in Google Cloud and point the callback to your server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/drive/auth/callback
GOOGLE_DRIVE_FOLDER_NAME=Dairy Farm Backups
